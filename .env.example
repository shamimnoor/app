# =============================================================================
# Shamim Noor — Founder OS · Environment variables (example)
# Copy each block into the right .env file before deploying.
# DO NOT commit real values — this file is checked in; real .env files are
# gitignored.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Vercel Project Environment Variables (Frontend + Edge Function)
#    Paste these in the Vercel dashboard → Project → Settings → Environment Variables
#    They are ALSO mirrored into /app/frontend/.env for the local preview.
# -----------------------------------------------------------------------------

# Supabase project (Settings → API)
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_ANON_KEY=eyJhbGciOiJI...your-anon-key...

# Founder identity (the email that auto-promotes to admin role on signup)
REACT_APP_FOUNDER_EMAIL=shamimnoorofficial@gmail.com

# n8n instance (cloud or self-hosted) for the Automation Center iframe
REACT_APP_N8N_EMBED_URL=https://your-n8n.example.com

# AI Copilot (server-side only — used by /api/copilot Vercel Edge Function)
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-5.2

# Leave BLANK on Vercel — the frontend calls /api/copilot directly.
# In Emergent / local preview, set to the FastAPI shim URL (the preview ingress URL).
REACT_APP_BACKEND_URL=

# -----------------------------------------------------------------------------
# 2. Emergent preview SHIM (FastAPI) — /app/backend/.env
#    Only used when running this repo inside the Emergent preview environment.
#    Vercel deployment ignores the /backend folder entirely.
# -----------------------------------------------------------------------------

MONGO_URL="mongodb://localhost:27017"
DB_NAME="shamim_noor_platform"
CORS_ORIGINS="*"
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-5.2
FOUNDER_EMAIL=shamimnoorofficial@gmail.com
